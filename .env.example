# AXOR — example environment. Copy to .env and fill in locally.
# This file must contain placeholders only. NEVER put real secrets here.

NODE_ENV=development

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Backend
# In production (ADR-0016) the server refuses to start unless WEB_ORIGIN is https, LOG_LEVEL is not
# debug/trace, and the DATABASE_URL user is not root.
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Database (MariaDB). Placeholders only. Tests automatically switch to the axor_test database.
DATABASE_URL=mysql://axor_app:CHANGE_ME@127.0.0.1:3306/axor_dev
# Database limits per API instance (ADR-0019). Keep (pool size x instances) below MariaDB max_connections.
# Requests beyond the queue limit get 503; a statement running past the timeout is killed (0 = no limit).
DB_POOL_SIZE=10
DB_POOL_QUEUE_LIMIT=100
DB_STATEMENT_TIMEOUT_MS=15000

# Authentication (ADR-0004). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# In production the server refuses a guessable secret (few distinct characters, or placeholder/test words; ADR-0017).
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_random_value_of_at_least_32_chars
# Rotation ONLY (ADR-0017 section 5): the old secret, accepted for verification, never for signing.
# Leave it commented out or empty normally. Remove it again once old tokens have expired.
# JWT_ACCESS_SECRET_PREVIOUS=CHANGE_ME_the_old_secret_while_rotating
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set to true ONLY behind your own reverse proxy so rate limits see the real client IP.
TRUST_PROXY=false
