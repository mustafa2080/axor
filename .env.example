# AXOR — example environment. Copy to .env and fill in locally.
# This file must contain placeholders only. NEVER put real secrets here.

NODE_ENV=development

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Backend
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Database (MariaDB). Placeholders only. Tests automatically switch to the axor_test database.
DATABASE_URL=mysql://axor_app:CHANGE_ME@127.0.0.1:3306/axor_dev

# Authentication (ADR-0004). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_random_value_of_at_least_32_chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set to true ONLY behind your own reverse proxy so rate limits see the real client IP.
TRUST_PROXY=false
