# AXOR — example environment. Copy to .env and fill in locally.
# This file must contain placeholders only. NEVER put real secrets here.

NODE_ENV=development

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Backend
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Database (MariaDB). Placeholders only. Tests automatically switch to the axor_test database.
DATABASE_URL=mysql://axor_app:CHANGE_ME@127.0.0.1:3306/axor_dev
